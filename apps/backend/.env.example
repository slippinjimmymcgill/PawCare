# App
ENVIRONMENT=development
SECRET_KEY=changeme-generate-a-real-random-value
DEBUG=true

# Database (P1-BE-002 provisions the real values; local dev can point at
# a Docker Compose Postgres in the meantime)
DATABASE_URL=postgresql+psycopg://pawcare:pawcare@localhost:5432/pawcare_dev

# Auth
JWT_SECRET_KEY=changeme-generate-a-separate-random-value
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM provider (blocked on P0-OPS-004 - provider decision + billed key)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Object storage (for health-record attachments, P1-BE-006)
OBJECT_STORAGE_PROVIDER=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_KEY=
OBJECT_STORAGE_SECRET=

# Knowledge base embeddings (P1-RAG-004)
# sentence_transformers = local all-MiniLM-L6-v2 (needs the optional
# sentence-transformers package); hashing = deterministic offline baseline.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=64

# CORS
FRONTEND_ORIGIN=http://localhost:3000
